# Docelowa domena produkcyjna (fallback w kodzie: https://ohclub.app)
NEXT_PUBLIC_SITE_URL=https://ohclub.app

# Google Analytics 4 — Measurement ID z panelu GA4 (Administracja → Strumienie danych)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta Pixel — Identyfikator piksela z Facebook Events Manager
NEXT_PUBLIC_META_PIXEL_ID=

# Strapi CMS — zakładka "Twórcy treści" (/tworcy). Token TYLKO read-only, server-side
# (bez prefiksu NEXT_PUBLIC_ — nigdy nie trafia do bundla klienta).
STRAPI_URL=https://useful-sparkle-79935e08b6.strapiapp.com
STRAPI_API_TOKEN=

# Strapi CMS — akcja "claim" na /odbierz (wydawanie kodów promocyjnych 1 miesiąc za darmo).
# Osobny token typu "Custom" z uprawnieniem WYŁĄCZNIE do Promo-code.claim (least privilege —
# ten sam server-side, nigdy w bundlu klienta). Utwórz w Strapi: Settings → API Tokens.
STRAPI_PROMO_TOKEN=

# ─── Konsultacje (płatne, /konsultacje) ──────────────────────────────────────

# Strapi CMS — osobny token typu "Custom" (least privilege) TYLKO do akcji zamówień
# konsultacji: consultation-order.createPending, consultation-order.markPaid,
# consultation-order.update (patch faktury/emaila), consultation-code.find/findOne.
# Server-side, nigdy w bundlu klienta. Utwórz w Strapi: Settings → API Tokens.
STRAPI_CONSULTATION_TOKEN=

# Stripe — klucz sekretny (sk_test_... / sk_live_...) i sekret podpisu webhooka
# (whsec_...). Oba server-side, nigdy NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Fakturownia — API token z panelu (Ustawienia → API) + subdomena konta
# (np. "ohclub" dla ohclub.fakturownia.pl).
FAKTUROWNIA_API_TOKEN=
FAKTUROWNIA_DOMAIN=

# Resend — API key (re_...) do e-maila potwierdzającego z linkiem do Calendly.
# RESEND_FROM: nadawca; domena musi być zweryfikowana w Resend (prereq A0.3).
RESEND_API_KEY=
RESEND_FROM="OH! Club <kontakt@ohclub.app>"
