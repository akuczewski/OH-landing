# Docelowa domena produkcyjna (fallback w kodzie: https://ohclub.app)
NEXT_PUBLIC_SITE_URL=https://ohclub.app

# Google Analytics 4 — Measurement ID z panelu GA4 (Administracja → Strumienie danych)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Strapi CMS — zakładka "Twórcy treści" (/tworcy). Token TYLKO read-only, server-side
# (bez prefiksu NEXT_PUBLIC_ — nigdy nie trafia do bundla klienta).
STRAPI_URL=https://useful-sparkle-79935e08b6.strapiapp.com
STRAPI_API_TOKEN=

# Strapi CMS — akcja "claim" na /odbierz (wydawanie kodów promocyjnych 1 miesiąc za darmo).
# Osobny token typu "Custom" z uprawnieniem WYŁĄCZNIE do Promo-code.claim (least privilege —
# ten sam server-side, nigdy w bundlu klienta). Utwórz w Strapi: Settings → API Tokens.
STRAPI_PROMO_TOKEN=
